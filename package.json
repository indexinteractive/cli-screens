{
  "name": "@ind3x/cli-screens",
  "license": "MIT",
  "version": "1.1.0",
  "homepage": "https://ind3x.games",
  "packageManager": "bun@1.3.14",
  "author": "contact@ind3x.games",
  "description": "A small screen stack library for interactive CLI applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indexinteractive/cli-screens.git"
  },
  "keywords": [
    "cli",
    "terminal",
    "prompt",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun run build && bun test --pass-with-no-tests",
    "prepublishOnly": "bun run build",
    "check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-plugin-dts": "^0.4.0",
    "typescript": "6.0.2"
  }
}
