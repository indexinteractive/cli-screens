{
    "compilerOptions": {
        "lib": [
            "ESNext"
        ],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "allowJs": false,
        "skipLibCheck": true,
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "types": [
            "bun",
            "node"
        ]
    },
    "include": [
        "src",
        "__tests__"
    ]
}